    "rebuild_caution_add_drive" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rebuild von %@ kann bei so großen Laufwerken Tage dauern, und ein zweiter Ausfall währenddessen kostet das ganze Array. Mit einem vierten Laufwerk wäre RAID 6 möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebuilding %@ on drives this large can take days, and a second failure during the rebuild loses the array. A fourth drive would allow RAID 6."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruir un %@ con unidades tan grandes puede tardar días, y un segundo fallo durante la reconstrucción hace perder el conjunto. Con una cuarta unidad sería posible usar RAID 6."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruire un %@ avec des disques aussi gros peut prendre des jours, et une seconde panne pendant la reconstruction fait perdre la grappe. Un quatrième disque permettrait le RAID 6."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruire un %@ con dischi così grandi può richiedere giorni e un secondo guasto durante la ricostruzione fa perdere l’array. Un quarto disco consentirebbe il RAID 6."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これほど大容量のドライブでは%@の再構築に数日かかることがあり、その間に2台目が故障するとアレイ全体を失います。4台目のドライブを追加すれば、RAID 6が使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 큰 드라이브에서는 %@ 재구축에 며칠이 걸릴 수 있으며, 재구축 중 두 번째 장애가 발생하면 어레이가 손실됩니다. 드라이브를 4개로 늘리면 RAID 6을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruir um %@ com discos tão grandes pode levar dias, e uma segunda falha durante a reconstrução faz perder o conjunto. Um quarto disco permitiria o RAID 6."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这么大的硬盘上重建 %@ 可能需要数天，重建期间如再有一块硬盘故障，整个阵列都会丢失。再加第四块硬盘，就可以使用 RAID 6。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這麼大的硬碟上重建 %@ 可能需要數天，重建期間若再有一顆故障，就會遺失整個陣列。再加第四顆硬碟，就能使用 RAID 6。"
          }
        }
      }
    },
    "rebuild_caution_level" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rebuild von %1$@ kann bei so großen Laufwerken Tage dauern, und ein zweiter Ausfall währenddessen kostet das ganze Array. Zieh %2$@ in Betracht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebuilding %1$@ on drives this large can take days, and a second failure during the rebuild loses the array. Consider %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruir un %1$@ con unidades tan grandes puede tardar días, y un segundo fallo durante la reconstrucción hace perder el conjunto. Considera %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruire un %1$@ avec des disques aussi gros peut prendre des jours, et une seconde panne pendant la reconstruction fait perdre la grappe. Envisagez le %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruire un %1$@ con dischi così grandi può richiedere giorni e un secondo guasto durante la ricostruzione fa perdere l’array. Valuta il %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これほど大容量のドライブでは%1$@の再構築に数日かかることがあり、その間に2台目が故障するとアレイ全体を失います。%2$@を検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 큰 드라이브에서는 %1$@ 재구축에 며칠이 걸릴 수 있으며, 재구축 중 두 번째 장애가 발생하면 어레이가 손실됩니다. %2$@ 사용을 고려해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruir um %1$@ com discos tão grandes pode levar dias, e uma segunda falha durante a reconstrução faz perder o conjunto. Considere o %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
