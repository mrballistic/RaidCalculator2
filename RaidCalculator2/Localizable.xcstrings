      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoschnitt und temporäre Arbeitsdateien\nGaming und Anwendungen mit hohem I/O-Bedarf\nCache oder temporäre Speichersysteme"
