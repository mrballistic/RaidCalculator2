          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージ容量効率50%\n使用可能GBあたりのコストが高い\n単一ドライブに類似した書き込みパフォーマンス"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스토리지 용량 효율 50%\n사용 가능 GB당 비용이 높음\n쓰기 성능이 단일 드라이브와 비슷함"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50% de eficiência da capacidade de armazenamento\nCusto mais alto por GB utilizável\nDesempenho de gravação semelhante ao de uma única unidade"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储容量利用率为 50%\n每 GB 可用容量的成本较高\n写入性能与单块硬盘相近"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存容量效率為 50%\n每 GB 可用容量的成本較高\n寫入效能與單顆硬碟相近"
          }
        }
      }
    },
    "raid1_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Spiegelung) legt exakte Kopien der Daten auf mehreren Laufwerken an. Bietet sehr gute Redundanz, halbiert aber die nutzbare Kapazität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Mirroring) creates exact copies of data on multiple drives. Provides excellent redundancy but halves the usable capacity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Mirroring) crea copias exactas de datos en múltiples unidades. Proporciona excelente redundancia pero reduce a la mitad la capacidad utilizable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Mirroring) crée des copies exactes des données sur plusieurs disques. Fournit une excellente redondance mais réduit de moitié la capacité utilisable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Mirroring) crea copie esatte dei dati su più dischi. Fornisce eccellente ridondanza ma dimezza la capacità utilizzabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1（ミラーリング）は複数のドライブにデータの正確なコピーを作成します。優れた冗長性を提供しますが、使用可能容量は半分になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1(미러링)은 여러 드라이브에 데이터의 정확한 사본을 만듭니다. 뛰어난 중복성을 제공하지만 사용 가능 용량이 절반으로 줄어듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RAID 1 (espelhamento) cria cópias exatas dos dados em várias unidades. Oferece excelente redundância, mas reduz pela metade a capacidade utilizável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1（镜像）在多块硬盘上创建完全相同的数据副本。冗余出色，但可用容量减半。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1（鏡像）會在多顆硬碟上建立完全相同的資料副本，提供優異的備援，但可用容量會減半。"
          }
        }
      }
    },
