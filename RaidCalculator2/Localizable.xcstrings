    },
    "zfs_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checksums detect and repair silent corruption\nSnapshots and replication are built in\nRAID-Z2 and Z3 protect large pools well"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sumas de verificación detectan y reparan la corrupción silenciosa\nInstantáneas y replicación integradas\nRAID-Z2 y Z3 protegen bien los pools grandes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sommes de contrôle détectent et réparent la corruption silencieuse\nInstantanés et réplication intégrés\nLes RAID-Z2 et Z3 protègent bien les grands pools"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I checksum rilevano e riparano la corruzione silenziosa\nSnapshot e replica integrati\nRAID-Z2 e Z3 proteggono bene i pool di grandi dimensioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックサムがサイレントな破損を検出して修復\nスナップショットとレプリケーションを標準搭載\nRAID-Z2とZ3は大規模プールをしっかり保護"
          }
        }
      }
    },
