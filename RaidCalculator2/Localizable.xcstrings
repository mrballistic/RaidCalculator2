    "jbod_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfach und flexibel\nVolle Nutzung der gesamten Laufwerkskapazität\nKein Leistungsverlust durch RAID-Berechnungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple and flexible\nFull utilization of all drive capacity\nNo performance overhead from RAID calculations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple y flexible\nUtilización completa de toda la capacidad de unidades\nSin sobrecarga de rendimiento de cálculos RAID"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple et flexible\nUtilisation complète de toute la capacité des disques\nAucune surcharge de performance des calculs RAID"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semplice e flessibile\nUtilizzazione completa di tutta la capacità dei dischi\nNessun overhead prestazioni dai calcoli RAID"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンプルで柔軟\nすべてのドライブ容量の完全な利用\nRAID計算からのパフォーマンスオーバーヘッドなし"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간단하고 유연함\n모든 드라이브 용량을 전부 활용\nRAID 연산으로 인한 성능 오버헤드 없음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simples e flexível\nAproveitamento total da capacidade de todas as unidades\nSem sobrecarga de desempenho dos cálculos de RAID"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简单灵活\n充分利用所有硬盘容量\n没有 RAID 计算带来的性能开销"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡單又靈活\n完整運用所有硬碟容量\n沒有 RAID 運算帶來的效能負擔"
          }
        }
      }
    },
