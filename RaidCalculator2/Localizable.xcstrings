    "parity_needs_data" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht neben den Paritätslaufwerken mindestens ein Datenlaufwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ needs at least one data drive besides its parity drives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita al menos un disco de datos además de sus discos de paridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nécessite au moins un disque de données en plus de ses disques de parité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ richiede almeno un disco dati oltre ai dischi di parità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には、パリティドライブのほかに1台以上のデータドライブが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 패리티 드라이브 외에 데이터 드라이브가 1개 이상 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ precisa de pelo menos um disco de dados além dos discos de paridade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 除校验盘外至少还需要一块数据盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了同位元硬碟之外，%@ 至少還需要一顆資料硬碟。"
          }
        }
      }
    },
    "parity_promotion_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die größten Laufwerke werden für die Parität verwendet, daher ist die Parität immer mindestens so groß wie jedes Datenlaufwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The largest drives are used as parity, so parity is always at least as large as every data drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los discos más grandes se usan como paridad, así que la paridad siempre es al menos tan grande como cada disco de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plus grands disques servent de parité : la parité est donc toujours au moins aussi grande que chaque disque de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dischi più grandi vengono usati come parità, quindi la parità è sempre grande almeno quanto ogni disco dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も大きいドライブがパリティとして使われるため、パリティは常にすべてのデータドライブ以上の容量になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 큰 드라이브가 패리티로 사용되므로, 패리티는 항상 모든 데이터 드라이브와 같거나 더 큽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os discos maiores são usados como paridade, então a paridade é sempre pelo menos tão grande quanto cada disco de dados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大的硬盘用作校验盘，因此校验盘始终不小于任何一块数据盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大的硬碟會用作同位元，因此同位元一定不小於任何一顆資料硬碟。"
          }
        }
      }
    },
