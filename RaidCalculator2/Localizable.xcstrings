    "jbod_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No redundancy or data protection\nDrive failure affects only data on that drive\nNo performance benefits of striping"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin redundancia o protección de datos\nEl fallo de unidad afecta solo datos en esa unidad\nSin beneficios de rendimiento de striping"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune redondance ou protection de données\nLa panne de disque n'affecte que les données sur ce disque\nAucun bénéfice de performance du striping"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna ridondanza o protezione dati\nIl guasto del disco influisce solo sui dati su quel disco\nNessun beneficio prestazioni dello striping"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ冗長性または保護なし\nドライブ故障はそのドライブのデータのみに影響\nストライピングのパフォーマンス利点なし"
          }
        }
      }
    },
    "jbod_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) combines multiple drives as one large volume without any RAID features. Each drive operates independently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) combina múltiples unidades como un solo volumen grande sin características RAID. Cada unidad opera independientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) combine plusieurs disques comme un seul grand volume sans fonctionnalités RAID. Chaque disque opère indépendamment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) combina più dischi come un unico volume grande senza funzionalità RAID. Ogni disco opera indipendentemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD（ジャストアバンチオブディスクス）はRAID機能なしで複数のドライブを1つの大きなボリュームとして結合します。各ドライブは独立して動作します。"
          }
        }
      }
    },
    "jbod_failures" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 (you lose data on any failed drive)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
