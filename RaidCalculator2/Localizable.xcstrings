    },
    "unraid_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beliebig große Laufwerke kombinierbar, ohne Platzverlust\nLaufwerke einzeln hinzufügen\nFallen mehr Laufwerke aus, als die Parität abdeckt, behalten die intakten Datenlaufwerke ihre Dateien"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix drive sizes freely, with no space lost\nAdd one drive at a time\nIf more drives fail than parity covers, the surviving data drives still hold their files"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite combinar libremente unidades de distintos tamaños, sin perder espacio\nPermite añadir unidades de una en una\nSi fallan más unidades de las que cubre la paridad, las unidades de datos restantes conservan sus archivos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disques de tailles différentes combinables librement, sans perte d’espace\nAjout de disques un par un\nSi plus de disques tombent en panne que la parité n’en couvre, les disques de données restants conservent leurs fichiers"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dischi di dimensioni diverse combinabili liberamente, senza perdita di spazio\nSi può aggiungere un disco alla volta\nSe si guastano più dischi di quanti ne copra la parità, i dischi dati superstiti conservano i loro file"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量の異なるドライブを自由に組み合わせても容量を失わない\nドライブを1台ずつ追加できる\nパリティでカバーできる以上のドライブが故障しても、残ったデータドライブのファイルは失われない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기가 다른 드라이브를 자유롭게 섞어도 공간 손실 없음\n드라이브를 하나씩 추가 가능\n패리티가 감당할 수 있는 것보다 많은 드라이브에 장애가 발생해도 남은 데이터 드라이브의 파일은 유지됨"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina livremente unidades de tamanhos diferentes, sem perder espaço\nPermite adicionar uma unidade de cada vez\nSe falharem mais unidades do que a paridade cobre, as unidades de dados que sobrevivem mantêm seus arquivos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随意混用不同容量的硬盘，不损失空间\n每次可添加一块硬盘\n即使故障硬盘多于校验盘的保护范围，未故障的数据盘上的文件仍然保留"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可自由混用不同容量的硬碟，不損失任何空間\n一次可加入一顆硬碟\n即使故障的硬碟數超出同位元的保護範圍，倖存資料硬碟上的檔案仍會保留"
          }
        }
      }
    },
    "unraid_use_cases" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medienserver für zu Hause, die Laufwerk für Laufwerk wachsen\nGemischte Sammlungen aus alten und neuen Laufwerken\nServer, auf denen auch Apps und virtuelle Maschinen laufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home media servers that grow a drive at a time\nMixed collections of old and new drives\nServers that also run apps and virtual machines"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidores multimedia domésticos que crecen unidad a unidad\nColecciones mixtas de unidades antiguas y nuevas\nServidores que también ejecutan aplicaciones y máquinas virtuales"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveurs multimédias domestiques qui s’agrandissent disque par disque\nAssortiments de disques anciens et récents\nServeurs qui font aussi tourner des applications et des machines virtuelles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media server domestici che crescono un disco alla volta\nRaccolte miste di dischi vecchi e nuovi\nServer che eseguono anche app e macchine virtuali"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライブを1台ずつ増やしていく家庭用メディアサーバー\n新旧のドライブが混在する構成\nアプリや仮想マシンも動かすサーバー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드라이브를 하나씩 늘려 가는 가정용 미디어 서버\n새 드라이브와 오래된 드라이브가 섞인 구성\n앱과 가상 머신도 실행하는 서버"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidores de mídia domésticos que crescem uma unidade por vez\nColeções mistas de unidades antigas e novas\nServidores que também executam apps e máquinas virtuais"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次增加一块硬盘的家用媒体服务器\n新旧硬盘混用的组合\n同时运行应用和虚拟机的服务器"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次增加一顆硬碟的家用媒體伺服器\n混用新舊硬碟的配置\n同時執行 App 與虛擬機器的伺服器"
          }
        }
      }
    },
