    "zfs_padding_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppenbreite verliert durch RAID‑Z-Padding etwa %@ zusätzlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group width loses about %@ more to RAID‑Z padding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con este ancho de grupo se pierde aproximadamente un %@ más por el relleno de RAID‑Z."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette largeur de groupe perd environ %@ de plus à cause du remplissage RAID‑Z."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
