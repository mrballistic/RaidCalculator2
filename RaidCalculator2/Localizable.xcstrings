    "raid50_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two failures in the same group lose the whole array\nNeeds at least six drives\nGives up one drive per group to parity"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos fallos en el mismo grupo hacen perder todo el conjunto\nRequiere al menos seis unidades\nDedica una unidad por grupo a la paridad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux pannes dans le même groupe font perdre toute la grappe\nNécessite au moins six disques\nConsacre un disque par groupe à la parité"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due guasti nello stesso gruppo fanno perdere l’intero array\nRichiede almeno sei dischi\nDedica un disco per gruppo alla parità"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じグループで2台故障するとアレイ全体を失う\n6台以上のドライブが必要\nグループごとに1台分をパリティに使う"
          }
        }
      }
    },
    "raid50_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 50 stripes data across two or more RAID 5 groups, each keeping one drive’s worth of parity. Writes spread across the groups, so it’s faster than a single RAID 5 array. A rebuild only touches one group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 50 distribuye los datos en franjas entre dos o más grupos RAID 5, y cada uno reserva el equivalente a una unidad para paridad. Las escrituras se reparten entre los grupos, por lo que es más rápido que un solo conjunto RAID 5. Una reconstrucción solo afecta a un grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le RAID 50 répartit les données en bandes sur deux groupes RAID 5 ou plus, chacun consacrant l’équivalent d’un disque à la parité. Les écritures sont réparties entre les groupes : il est donc plus rapide qu’une seule grappe RAID 5. Une reconstruction ne concerne qu’un seul groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 50 distribuisce i dati in striping su due o più gruppi RAID 5, ognuno dei quali riserva l’equivalente di un disco alla parità. Le scritture si distribuiscono tra i gruppi, quindi è più veloce di un singolo array RAID 5. Una ricostruzione coinvolge un solo gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 50は、2つ以上のRAID 5グループにまたがってデータをストライピングし、各グループがドライブ1台分のパリティを持ちます。書き込みがグループ間に分散されるため、単一のRAID 5アレイより高速です。再構築は1つのグループだけで完了します。"
          }
        }
      }
    },
    "raid50_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faster than RAID 5, because writes spread across groups\nA rebuild only reads the drives in one group\nCan survive one failure in every group"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más rápido que RAID 5, porque las escrituras se reparten entre grupos\nUna reconstrucción solo lee las unidades de un grupo\nPuede sobrevivir a un fallo en cada grupo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus rapide que le RAID 5, car les écritures sont réparties entre les groupes\nUne reconstruction ne lit que les disques d’un seul groupe\nPeut survivre à une panne dans chaque groupe"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più veloce di RAID 5, perché le scritture si distribuiscono tra i gruppi\nUna ricostruzione legge solo i dischi di un gruppo\nPuò sopravvivere a un guasto in ogni gruppo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き込みがグループ間に分散されるため、RAID 5より高速\n再構築時に読み取るのは1つのグループのドライブのみ\n各グループで1台の故障に耐えられる"
          }
        }
      }
    },
    "raid50_use_cases" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Large arrays that need more speed than RAID 5\nDatabases and virtual machines on many drives\nHardware RAID controllers that support nested levels"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conjuntos grandes que necesitan más velocidad que RAID 5\nBases de datos y máquinas virtuales en muchas unidades\nControladoras RAID por hardware que admiten niveles anidados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandes grappes qui exigent plus de vitesse que le RAID 5\nBases de données et machines virtuelles sur de nombreux disques\nContrôleurs RAID matériels qui prennent en charge les niveaux imbriqués"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Array di grandi dimensioni che richiedono più velocità di RAID 5\nDatabase e macchine virtuali su molti dischi\nController RAID hardware che supportano i livelli annidati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 5以上の速度が必要な大規模アレイ\n多数のドライブ上のデータベースと仮想マシン\nネストレベルに対応したハードウェアRAIDコントローラー"
          }
        }
      }
    },
    "raid5_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slower write performance due to parity calculation\nRebuild can be slow with large drives\nRisk of data loss during rebuild if another drive fails"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendimiento de escritura más lento debido al cálculo de paridad\nLa reconstrucción puede ser lenta con unidades grandes\nRiesgo de pérdida de datos durante reconstrucción si otra unidad falla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performances en écriture plus lentes dues au calcul de parité\nLa reconstruction peut être lente avec de grands disques\nRisque de perte de données pendant reconstruction si un autre disque tombe en panne"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prestazioni in scrittura più lente a causa del calcolo della parità\nLa ricostruzione può essere lenta con dischi grandi\nRischio di perdita dati durante la ricostruzione se un altro disco si guasta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パリティ計算により書き込みパフォーマンスが遅い\n大容量ドライブでの再構築が遅い場合がある\n他のドライブが故障した場合の再構築中のデータ損失リスク"
          }
        }
      }
    },
    "raid5_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 5 (Striping with Parity) distributes data and parity across all drives. Provides good performance and redundancy with minimal capacity overhead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 5 (Striping con Paridad) distribuye datos y paridad en todas las unidades. Proporciona buen rendimiento y redundancia con sobrecarga mínima de capacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 5 (Striping avec Parité) distribue les données et la parité sur tous les disques. Fournit de bonnes performances et redondance avec une surcharge minimale de capacité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 5 (Striping con Parità) distribuisce dati e parità su tutti i dischi. Fornisce buone prestazioni e ridondanza con overhead minimo della capacità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 5（パリティ付きストライピング）はすべてのドライブにデータとパリティを分散します。最小限の容量オーバーヘッドで良いパフォーマンスと冗長性を提供します。"
          }
        }
      }
    },
