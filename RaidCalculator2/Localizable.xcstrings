    "nested_needs_two_groups" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ braucht mindestens zwei Gruppen. Mit einer Gruppe ist es %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ needs at least two groups. With one group, it’s %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ necesita al menos dos grupos. Con un solo grupo, es %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nécessite au moins deux groupes. Avec un seul groupe, c’est du %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ richiede almeno due gruppi. Con un solo gruppo, è %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@には少なくとも2つのグループが必要です。グループが1つの場合は%2$@になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에는 그룹이 2개 이상 필요합니다. 그룹이 1개이면 %2$@입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %1$@ precisa de pelo menos dois grupos. Com um só grupo, ele é um %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 至少需要两个组。只有一个组时，它就是 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 至少需要兩個群組。只有一個群組時，就是 %2$@。"
          }
        }
      }
    },
