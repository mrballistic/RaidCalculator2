    "unraid_calculation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The largest drives become parity, so parity is always at least as large as every data drive. Parity updates as you write, so protection is always current. Usable space is the total of the data drives, and the array survives as many drive failures as it has parity drives. Unraid’s separate cache and ZFS pools aren’t included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las unidades más grandes se usan para paridad, así que la paridad siempre es al menos tan grande como cada unidad de datos. La paridad se actualiza con cada escritura, por lo que la protección siempre está al día. El espacio utilizable es la suma de las unidades de datos, y el conjunto sobrevive a tantos fallos de unidad como unidades de paridad tenga. No se incluyen los pools de caché y ZFS independientes de Unraid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plus grands disques servent à la parité, qui est donc toujours au moins aussi grande que chaque disque de données. La parité se met à jour à chaque écriture, la protection est donc toujours actuelle. L’espace utilisable correspond au total des disques de données, et la grappe survit à autant de pannes de disque qu’elle compte de disques de parité. Les pools de cache et ZFS distincts d’Unraid ne sont pas inclus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dischi più grandi diventano dischi di parità, quindi la parità è sempre grande almeno quanto ogni disco dati. La parità si aggiorna a ogni scrittura, quindi la protezione è sempre aggiornata. Lo spazio utilizzabile è il totale dei dischi dati, e l’array sopravvive a tanti guasti quanti sono i suoi dischi di parità. I pool cache e ZFS separati di Unraid non sono inclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も大きいドライブがパリティになるため、パリティは常にすべてのデータドライブと同じかそれ以上の容量になります。パリティは書き込みのたびに更新されるため、保護は常に最新の状態です。使用可能容量はデータドライブの合計で、アレイはパリティドライブと同じ数のドライブ故障に耐えられます。Unraidの別個のキャッシュプールとZFSプールは含まれません。"
          }
        }
      }
    },
    "unraid_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each parity drive must be at least as large as your largest data drive\nWrites are slower than striped RAID\nReads are only as fast as a single drive"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada unidad de paridad debe ser al menos tan grande como la unidad de datos más grande\nEscrituras más lentas que en un RAID con striping\nLas lecturas no son más rápidas que con una sola unidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque disque de parité doit être au moins aussi grand que le plus grand disque de données\nÉcritures plus lentes qu’en RAID avec striping\nLectures pas plus rapides qu’avec un seul disque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni disco di parità deve essere grande almeno quanto il disco dati più grande\nScritture più lente del RAID in striping\nLetture non più veloci di un singolo disco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各パリティドライブには最大のデータドライブ以上の容量が必要\nストライピングRAIDより書き込みが遅い\n読み取り速度は単一ドライブと同じ"
          }
        }
      }
    },
    "unraid_data_limit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unraid arrays hold up to 28 data drives plus 2 parity drives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un conjunto de Unraid admite hasta 28 discos de datos más 2 discos de paridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une grappe Unraid accepte jusqu’à 28 disques de données plus 2 disques de parité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un array Unraid contiene fino a 28 dischi dati più 2 dischi di parità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unraidのアレイには、データドライブを最大28台、パリティドライブを2台まで搭載できます。"
          }
        }
      }
    },
    "unraid_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unraid keeps each data drive as its own file system and protects them with one or two parity drives. Drives can be any size, and every data drive’s full capacity is usable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unraid mantiene cada unidad de datos con su propio sistema de archivos y las protege con una o dos unidades de paridad. Las unidades pueden ser de cualquier tamaño, y se puede usar toda la capacidad de cada unidad de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unraid conserve chaque disque de données sous la forme d’un système de fichiers indépendant et les protège avec un ou deux disques de parité. Les disques peuvent être de n’importe quelle taille, et toute la capacité de chaque disque de données est utilisable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unraid mantiene ogni disco dati come un file system a sé e li protegge con uno o due dischi di parità. I dischi possono essere di qualsiasi dimensione, e l’intera capacità di ogni disco dati è utilizzabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unraidは各データドライブをそれぞれ独立したファイルシステムとして保持し、1つまたは2つのパリティドライブで保護します。ドライブの容量は自由で、各データドライブの全容量を使用できます。"
          }
        }
      }
    },
    "unraid_not_affiliated" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not affiliated with or endorsed by Lime Technology, Inc. Unraid is a trademark of Lime Technology, Inc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin afiliación ni respaldo de Lime Technology, Inc. Unraid es una marca comercial de Lime Technology, Inc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non affilié à Lime Technology, Inc. ni approuvé par elle. Unraid est une marque de Lime Technology, Inc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non affiliato né approvato da Lime Technology, Inc. Unraid è un marchio di Lime Technology, Inc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lime Technology, Inc.とは提携しておらず、同社の承認も受けていません。UnraidはLime Technology, Inc.の商標です。"
          }
        }
      }
    },
    "unraid_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix drive sizes freely, with no space lost\nAdd one drive at a time\nIf more drives fail than parity covers, the surviving data drives still hold their files"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite combinar libremente unidades de distintos tamaños, sin perder espacio\nPermite añadir unidades de una en una\nSi fallan más unidades de las que cubre la paridad, las unidades de datos restantes conservan sus archivos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disques de tailles différentes combinables librement, sans perte d’espace\nAjout de disques un par un\nSi plus de disques tombent en panne que la parité n’en couvre, les disques de données restants conservent leurs fichiers"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dischi di dimensioni diverse combinabili liberamente, senza perdita di spazio\nSi può aggiungere un disco alla volta\nSe si guastano più dischi di quanti ne copra la parità, i dischi dati superstiti conservano i loro file"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量の異なるドライブを自由に組み合わせても容量を失わない\nドライブを1つずつ追加できる\nパリティでカバーできる以上のドライブが故障しても、残ったデータドライブのファイルは失われない"
          }
        }
      }
    },
    "unraid_use_cases" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home media servers that grow a drive at a time\nMixed collections of old and new drives\nServers that also run apps and virtual machines"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidores multimedia domésticos que crecen unidad a unidad\nColecciones mixtas de unidades antiguas y nuevas\nServidores que también ejecutan aplicaciones y máquinas virtuales"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveurs multimédias domestiques qui s’agrandissent disque par disque\nAssortiments de disques anciens et récents\nServeurs qui font aussi tourner des applications et des machines virtuelles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media server domestici che crescono un disco alla volta\nRaccolte miste di dischi vecchi e nuovi\nServer che eseguono anche app e macchine virtuali"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライブを1つずつ増やしていく家庭用メディアサーバー\n新旧のドライブが混在する構成\nアプリや仮想マシンも動かすサーバー"
          }
        }
      }
    },
