    "raid60_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Gruppe gehen zwei Laufwerke an die Parität\nBraucht mindestens acht Laufwerke\nLangsamer beim Schreiben als RAID 50"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gives up two drives per group to parity\nNeeds at least eight drives\nSlower writes than RAID 50"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedica dos unidades por grupo a la paridad\nRequiere al menos ocho unidades\nEscrituras más lentas que RAID 50"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consacre deux disques par groupe à la parité\nNécessite au moins huit disques\nÉcritures plus lentes qu’en RAID 50"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedica due dischi per gruppo alla parità\nRichiede almeno otto dischi\nScritture più lente di RAID 50"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループごとに2台分をパリティに使う\n8台以上のドライブが必要\nRAID 50より書き込みが遅い"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹마다 드라이브 2개 분량을 패리티에 사용\n드라이브가 8개 이상 필요\nRAID 50보다 쓰기가 느림"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedica duas unidades por grupo à paridade\nPrecisa de pelo menos oito unidades\nGravação mais lenta que a do RAID 50"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每组要拿出两块硬盘的容量用于校验\n至少需要八块硬盘\n写入比 RAID 50 慢"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個群組要撥出兩顆硬碟作為同位元\n至少需要八顆硬碟\n寫入速度比 RAID 50 慢"
          }
        }
      }
    },
    "raid60_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 60 verteilt Daten per Striping auf zwei oder mehr RAID-6-Gruppen. Jede Gruppe hält zwei Laufwerke an Parität vor, daher dürfen zwei beliebige Laufwerke ausfallen, oft auch mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 60 stripes data across two or more RAID 6 groups. Each group keeps two drives’ worth of parity, so any two drives can fail, and often more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 60 distribuye los datos en franjas entre dos o más grupos RAID 6. Cada grupo reserva el equivalente a dos unidades para paridad, por lo que pueden fallar dos unidades cualesquiera, y a menudo más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le RAID 60 répartit les données en bandes sur deux groupes RAID 6 ou plus. Chaque groupe consacre l’équivalent de deux disques à la parité : deux disques quelconques peuvent donc tomber en panne, et souvent davantage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 60 distribuisce i dati in striping su due o più gruppi RAID 6. Ogni gruppo riserva l’equivalente di due dischi alla parità, quindi possono guastarsi due dischi qualsiasi, e spesso anche di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 60は、2つ以上のRAID 6グループにまたがってデータをストライピングします。各グループがドライブ2台分のパリティを持つため、どの2台が故障しても耐えられ、多くの場合それ以上にも耐えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 60은 두 개 이상의 RAID 6 그룹에 걸쳐 데이터를 스트라이핑합니다. 각 그룹이 드라이브 2개 분량의 패리티를 유지하므로 어떤 드라이브 2개에 장애가 발생해도 견딜 수 있으며, 그 이상도 견디는 경우가 많습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RAID 60 distribui os dados em faixas entre dois ou mais grupos RAID 6. Cada grupo reserva o equivalente a duas unidades para paridade, então quaisquer duas unidades podem falhar, e muitas vezes mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 60 将数据条带化到两个或更多 RAID 6 组上。每组保留两块硬盘容量的校验数据，因此任意两块硬盘故障都不会丢失数据，很多情况下还能承受更多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 60 將資料等量分割到兩個以上的 RAID 6 群組。每個群組保留相當於兩顆硬碟的同位元，因此任意兩顆硬碟故障都能承受，而且通常還能承受更多。"
          }
        }
      }
    },
    "raid60_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersteht zwei beliebige Laufwerksausfälle, und bis zu zwei pro Gruppe\nSchneller als ein einzelnes RAID-6-Array\nEin Rebuild liest nur die Laufwerke einer Gruppe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survives any two drive failures, and up to two per group\nFaster than a single RAID 6 array\nA rebuild only reads the drives in one group"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrevive a dos fallos de unidad cualesquiera, y hasta dos por grupo\nMás rápido que un solo conjunto RAID 6\nUna reconstrucción solo lee las unidades de un grupo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survit à deux pannes de disque quelconques, et jusqu’à deux par groupe\nPlus rapide qu’une seule grappe RAID 6\nUne reconstruction ne lit que les disques d’un seul groupe"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopravvive a due guasti qualsiasi dei dischi, e fino a due per gruppo\nPiù veloce di un singolo array RAID 6\nUna ricostruzione legge solo i dischi di un gruppo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの2台のドライブ故障にも耐え、グループごとに最大2台まで耐えられる\n単一のRAID 6アレイより高速\n再構築時に読み取るのは1つのグループのドライブのみ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 드라이브 2개의 장애도 견디며, 그룹마다 최대 2개까지 견딤\n단일 RAID 6 어레이보다 빠름\n재구축 시 한 그룹의 드라이브만 읽음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrevive à falha de quaisquer duas unidades, e de até duas por grupo\nMais rápido que um único conjunto RAID 6\nUma reconstrução lê apenas as unidades de um grupo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可承受任意两块硬盘故障，每组最多可承受两块\n比单个 RAID 6 阵列更快\n重建时只读取一个组内的硬盘"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可承受任意兩顆硬碟故障，每個群組最多可承受兩顆\n比單一 RAID 6 陣列更快\n重建時只需讀取一個群組中的硬碟"
          }
        }
      }
    },
    "raid60_use_cases" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große Arrays, bei denen Datenverlust keine Option ist\nBackup- und Archivserver mit vielen großen Laufwerken\nHardware-RAID-Controller, die verschachtelte Level unterstützen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Large arrays where losing data isn’t an option\nBackup and archive servers with many big drives\nHardware RAID controllers that support nested levels"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conjuntos grandes en los que perder datos no es una opción\nServidores de backup y archivo con muchas unidades grandes\nControladoras RAID por hardware que admiten niveles anidados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandes grappes où la perte de données est exclue\nServeurs de sauvegarde et d’archivage avec de nombreux gros disques\nContrôleurs RAID matériels qui prennent en charge les niveaux imbriqués"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Array di grandi dimensioni in cui perdere dati non è un’opzione\nServer di backup e archiviazione con molti dischi grandi\nController RAID hardware che supportano i livelli annidati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ損失が許されない大規模アレイ\n大容量ドライブを多数搭載したバックアップ・アーカイブサーバー\nネスト構成のRAIDレベルに対応したハードウェアRAIDコントローラー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 손실이 허용되지 않는 대규모 어레이\n대용량 드라이브가 많은 백업 및 아카이브 서버\n중첩 레벨을 지원하는 하드웨어 RAID 컨트롤러"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conjuntos grandes em que perder dados não é uma opção\nServidores de backup e arquivamento com muitas unidades grandes\nControladoras RAID de hardware compatíveis com níveis aninhados"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不能丢失数据的大型阵列\n配有大量大容量硬盘的备份和归档服务器\n支持嵌套级别的硬件 RAID 控制器"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不能遺失資料的大型陣列\n搭載多顆大容量硬碟的備份與封存伺服器\n支援巢狀等級的硬體 RAID 控制器"
          }
        }
      }
    },
    "raid6_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Kapazitätsverlust als RAID 5\nLangsamere Schreibleistung als RAID 5\nAufwendigere Umsetzung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher capacity overhead than RAID 5\nSlower write performance than RAID 5\nMore complex implementation"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mayor sobrecarga de capacidad que RAID 5\nRendimiento de escritura más lento que RAID 5\nImplementación más compleja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surcharge de capacité supérieure à RAID 5\nPerformances en écriture plus lentes que RAID 5\nImplémentation plus complexe"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overhead capacità maggiore di RAID 5\nPrestazioni in scrittura più lente di RAID 5\nImplementazione più complessa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 5より容量オーバーヘッドが大きい\nRAID 5より書き込みパフォーマンスが遅い\nより複雑な実装"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 5보다 용량 오버헤드가 큼\nRAID 5보다 쓰기 성능이 느림\n구현이 더 복잡함"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perda de capacidade maior que a do RAID 5\nGravação mais lenta que a do RAID 5\nImplementação mais complexa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量开销比 RAID 5 大\n写入性能比 RAID 5 慢\n实现更复杂"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量負擔比 RAID 5 高\n寫入效能比 RAID 5 慢\n建置較複雜"
          }
        }
      }
    },
    "raid6_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6 (Striping mit doppelter Parität) ähnelt RAID 5, nutzt aber zwei Paritätssätze. Übersteht zwei gleichzeitige Laufwerksausfälle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6 (Striping with Dual Parity) similar to RAID 5 but with two parity sets. Can survive two simultaneous drive failures."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6 (Striping con Doble Paridad) similar a RAID 5 pero con dos conjuntos de paridad. Puede sobrevivir a dos fallos simultáneos de unidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6 (Striping avec Double Parité) similaire à RAID 5 mais avec deux ensembles de parité. Peut survivre à deux pannes simultanées de disques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6 (Striping con Doppia Parità) simile a RAID 5 ma con due set di parità. Può sopravvivere a due guasti simultanei dei dischi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6（デュアルパリティ付きストライピング）はRAID 5に似ていますが、2つのパリティセットがあります。2つの同時ドライブ故障から復旧できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6(이중 패리티 포함 스트라이핑)은 RAID 5와 비슷하지만 패리티 세트가 두 개입니다. 드라이브 2개에 동시에 장애가 발생해도 견딜 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RAID 6 (striping com paridade dupla) é semelhante ao RAID 5, mas com dois conjuntos de paridade. Pode sobreviver à falha simultânea de duas unidades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6（带双重校验的条带化）与 RAID 5 类似，但有两组校验。可承受两块硬盘同时故障。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 6（含雙重同位元的等量分割）與 RAID 5 類似，但有兩組同位元，可承受兩顆硬碟同時故障。"
