    "zfs_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfsummen erkennen und reparieren unbemerkte Datenfehler\nSnapshots und Replikation sind integriert\nRAID-Z2 und Z3 schützen große Pools gut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checksums detect and repair silent corruption\nSnapshots and replication are built in\nRAID-Z2 and Z3 protect large pools well"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sumas de verificación detectan y reparan la corrupción silenciosa\nInstantáneas y replicación integradas\nRAID-Z2 y Z3 protegen bien los pools grandes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
