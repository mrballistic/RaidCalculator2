    "wide_zfs_group_caution" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede RAID‑Z-Gruppe ist %d Laufwerke breit. Sehr breite Gruppen brauchen nach einem Ausfall lange für den Rebuild; mehr, schmalere Gruppen sind schneller wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each RAID‑Z group is %d drives wide. Very wide groups take a long time to rebuild after a failure; more, narrower groups rebuild faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grupo RAID‑Z tiene %d unidades de ancho. Los grupos muy anchos tardan mucho en reconstruirse tras un fallo; más grupos, y más estrechos, se reconstruyen antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque groupe RAID‑Z fait %d disques de large. Les groupes très larges mettent longtemps à se reconstruire après une panne ; des groupes plus nombreux et plus étroits se reconstruisent plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni gruppo RAID‑Z è largo %d dischi. I gruppi molto larghi richiedono molto tempo per la ricostruzione dopo un guasto; più gruppi, più stretti, si ricostruiscono prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各RAID‑Zグループの幅はドライブ%d台です。幅が非常に広いグループは故障後の再構築に長い時間がかかります。より狭いグループを増やすと、再構築が速くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 RAID‑Z 그룹의 폭은 드라이브 %d개입니다. 매우 넓은 그룹은 장애 후 재구축에 오랜 시간이 걸립니다. 더 좁은 그룹을 여러 개 두면 재구축이 더 빠릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grupo RAID‑Z tem %d unidades de largura. Grupos muito largos demoram muito para se reconstruir após uma falha; mais grupos, e mais estreitos, se reconstroem mais rápido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个 RAID‑Z 组的宽度为 %d 块硬盘。超宽组在故障后需要很长时间重建；组数更多、每组更窄时，重建更快。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個 RAID‑Z 群組的寬度為 %d 顆硬碟。極寬的群組在故障後需要很長時間重建；改用更多、更窄的群組，重建會更快。"
          }
        }
      }
    },
    "wide_zfs_group_caution_single" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese RAID‑Z-Gruppe ist %d Laufwerke breit. Sehr breite Gruppen brauchen nach einem Ausfall lange für den Rebuild; mehr, schmalere Gruppen sind schneller wiederhergestellt."
