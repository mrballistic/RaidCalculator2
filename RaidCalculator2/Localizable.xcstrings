        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedica dos unidades por grupo a la paridad\nAlgunos anchos de grupo pierden espacio extra por el relleno\nUsa más memoria que el RAID por hardware"
