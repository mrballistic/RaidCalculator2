    "btrfs_calculation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der nutzbare Speicher ist die Hälfte der Gesamtkapazität, außer ein Laufwerk ist größer als alle anderen zusammen; dann ist es die Summe der kleineren Laufwerke, und der Rest des größten Laufwerks wird als ungenutzt angezeigt. Jedes Laufwerk wird zur Hälfte als Daten, zur Hälfte als Kopie dargestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usable space is half the total, unless one drive is larger than all the others combined; then it’s the total of the smaller drives, and the rest of the largest drive is shown as unused. Each drive is drawn half data, half copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio utilizable es la mitad del total, salvo que una unidad sea más grande que todas las demás juntas; en ese caso es la suma de las unidades más pequeñas, y el resto de la unidad más grande se muestra sin usar. Cada unidad se dibuja mitad datos, mitad copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace utilisable correspond à la moitié du total, sauf si un disque est plus grand que tous les autres réunis ; il correspond alors au total des plus petits disques, et le reste du plus grand disque est indiqué comme inutilisé. Chaque disque est représenté à moitié données, à moitié copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio utilizzabile è metà del totale, a meno che un disco non sia più grande di tutti gli altri messi insieme; in quel caso è il totale dei dischi più piccoli, e il resto del disco più grande è indicato come inutilizzato. Ogni disco è disegnato per metà dati e per metà copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用可能容量は総容量の半分です。ただし、1台のドライブが他のすべてのドライブの合計より大きい場合は、小さいドライブの合計となり、最大のドライブの残りは未使用として表示されます。各ドライブは半分をデータ、半分をコピーとして描いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 공간은 전체의 절반입니다. 단, 드라이브 하나가 나머지 모든 드라이브를 합친 것보다 크면 작은 드라이브들의 합계가 되며, 가장 큰 드라이브의 나머지 공간은 미사용으로 표시됩니다. 각 드라이브는 절반은 데이터, 절반은 사본으로 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço utilizável é metade do total, a menos que uma unidade seja maior que todas as outras juntas; nesse caso, é a soma das unidades menores, e o restante da unidade maior aparece como sem uso. Cada unidade é desenhada metade dados, metade cópia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空间为总容量的一半；但如果某块硬盘比其他所有硬盘的总和还大，可用空间则为较小硬盘的总和，最大硬盘的其余部分显示为未使用。每块硬盘都画成一半数据、一半副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用空間為總容量的一半；但若有一顆硬碟比其他所有硬碟的總和還大，可用空間則為較小硬碟的總和，最大硬碟的其餘部分會顯示為未使用。每顆硬碟的圖示都是一半資料、一半副本。"
          }
        }
      }
    },
    "btrfs_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hälfte des Gesamtspeichers enthält die zweite Kopie\nÜbersteht nur einen Laufwerksausfall, egal wie viele Laufwerke es sind\nEin Laufwerk, das größer ist als alle anderen zusammen, lässt sich nicht vollständig spiegeln"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half the total space holds the second copy\nSurvives only one drive failure, however many drives there are\nOne drive larger than all the others combined can’t be fully mirrored"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mitad del espacio total guarda la segunda copia\nSolo sobrevive a un fallo de unidad, sin importar cuántas unidades haya\nUna unidad más grande que todas las demás juntas no se puede duplicar por completo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moitié de l’espace total contient la seconde copie\nNe survit qu’à une seule panne de disque, quel que soit le nombre de disques\nUn disque plus grand que tous les autres réunis ne peut pas être entièrement mis en miroir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metà dello spazio totale contiene la seconda copia\nSopravvive al guasto di un solo disco, qualunque sia il numero di dischi\nUn disco più grande di tutti gli altri messi insieme non può essere interamente in mirror"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "総容量の半分が2つ目のコピーに使われる\nドライブ数に関係なく、1台の故障にしか耐えられない\n他のすべてのドライブの合計より大きいドライブは、全体をミラーできない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 공간의 절반이 두 번째 사본에 사용됨\n드라이브 수와 관계없이 드라이브 장애 1개만 견딤\n나머지 모든 드라이브를 합친 것보다 큰 드라이브는 전체를 미러링할 수 없음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metade do espaço total guarda a segunda cópia\nSobrevive a apenas uma falha de unidade, não importa quantas unidades haja\nUma unidade maior que todas as outras juntas não pode ser espelhada por completo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总空间的一半用于存放第二份副本\n无论有多少块硬盘，都只能承受一块硬盘故障\n比其他所有硬盘总和还大的硬盘无法完整镜像"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "總空間的一半用於存放第二份副本\n無論有幾顆硬碟，都只能承受一顆硬碟故障\n比其他所有硬碟總和還大的硬碟無法完整鏡像"
          }
        }
      }
    },
    "btrfs_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 speichert von jedem Datenblock zwei Kopien auf zwei verschiedenen Laufwerken. Die Laufwerke dürfen unterschiedlich groß sein; Btrfs verteilt die Kopien so, dass sie ausgeglichen sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 keeps two copies of every block of data, on two different drives. Drives can be different sizes; Btrfs places the copies so they balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 guarda dos copias de cada bloque de datos, en dos unidades distintas. Las unidades pueden ser de distintos tamaños; Btrfs coloca las copias de forma equilibrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Btrfs RAID1 conserve deux copies de chaque bloc de données, sur deux disques différents. Les disques peuvent être de tailles différentes ; Btrfs place les copies de façon équilibrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 conserva due copie di ogni blocco di dati, su due dischi diversi. I dischi possono avere dimensioni diverse; Btrfs distribuisce le copie in modo bilanciato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1は、すべてのデータブロックのコピーを2つ、別々のドライブに保持します。ドライブの容量は異なっていてもよく、Btrfsは偏りが出ないようにコピーを配置します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1은 모든 데이터 블록의 사본 두 개를 서로 다른 두 드라이브에 보관합니다. 드라이브 크기가 달라도 되며, Btrfs가 사본을 균형 있게 배치합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Btrfs RAID1 mantém duas cópias de cada bloco de dados, em duas unidades diferentes. As unidades podem ter tamanhos diferentes; o Btrfs distribui as cópias de forma equilibrada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 会把每个数据块保存两份，分别放在两块不同的硬盘上。硬盘容量可以不同，Btrfs 会均衡地放置副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 會將每個資料區塊保留兩份副本，分別存放在兩顆不同的硬碟上。硬碟容量可以不同，Btrfs 會平衡地配置副本。"
          }
        }
      }
    },
    "btrfs_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterschiedlich große Laufwerke kombinierbar, kaum Platzverlust\nLaufwerke hinzufügen oder entfernen und neu verteilen, während das Volume online bleibt\nPrüfsummen erkennen Datenfehler und reparieren sie aus der anderen Kopie"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix drive sizes with little wasted space\nAdd or remove drives and rebalance while the volume stays online\nChecksums detect corruption and repair it from the other copy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite combinar unidades de distintos tamaños con poco espacio desperdiciado\nPermite añadir o quitar unidades y reequilibrar sin desconectar el volumen\nLas sumas de verificación detectan la corrupción y la reparan con la otra copia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disques de tailles différentes combinables avec peu d’espace perdu\nAjout ou retrait de disques et rééquilibrage pendant que le volume reste en ligne\nLes sommes de contrôle détectent la corruption et la réparent à partir de l’autre copie"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dischi di dimensioni diverse combinabili con poco spazio sprecato\nSi possono aggiungere o rimuovere dischi e ribilanciare mentre il volume resta online\nI checksum rilevano la corruzione e la riparano dall’altra copia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量の異なるドライブを組み合わせても無駄が少ない\nボリュームをオンラインのままドライブの追加・削除やリバランスが可能\nチェックサムが破損を検出し、もう一方のコピーから修復"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기가 다른 드라이브를 섞어도 낭비되는 공간이 적음\n볼륨을 온라인 상태로 유지한 채 드라이브 추가, 제거 및 재조정 가능\n체크섬으로 손상을 감지하고 다른 사본에서 복구"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina unidades de tamanhos diferentes com pouco espaço desperdiçado\nPermite adicionar ou remover unidades e rebalancear com o volume online\nSomas de verificação detectam corrupção e a reparam com a outra cópia"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混用不同容量的硬盘，浪费的空间很少\n卷保持在线时即可添加或移除硬盘并重新平衡\n校验和可检测损坏，并用另一份副本修复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混用不同容量的硬碟也幾乎不浪費空間\n可在磁碟區維持線上時新增或移除硬碟並重新平衡\n總和檢查碼可偵測損毀，並從另一份副本修復"
          }
        }
      }
    },
