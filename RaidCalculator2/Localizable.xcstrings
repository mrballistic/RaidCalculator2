    "snapraid_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beliebig große Laufwerke kombinierbar, ohne Platzverlust\nBis zu sechs Paritätslaufwerke für große Sammlungen\nPrüfsummen erkennen unbemerkte Datenfehler, und die Dateien auf intakten Laufwerken bleiben lesbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix drive sizes freely, with no space lost\nUp to six parity drives for large collections\nChecksums detect silent corruption, and files on surviving drives stay readable"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite combinar libremente unidades de distintos tamaños, sin perder espacio\nHasta seis unidades de paridad para colecciones grandes\nLas sumas de verificación detectan la corrupción silenciosa, y los archivos de las unidades restantes siguen siendo legibles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disques de tailles différentes combinables librement, sans perte d’espace\nJusqu’à six disques de parité pour les grandes collections\nLes sommes de contrôle détectent la corruption silencieuse, et les fichiers des disques restants restent lisibles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dischi di dimensioni diverse combinabili liberamente, senza perdita di spazio\nFino a sei dischi di parità per raccolte di grandi dimensioni\nI checksum rilevano la corruzione silenziosa, e i file sui dischi superstiti restano leggibili"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量の異なるドライブを自由に組み合わせても容量を失わない\n大規模なコレクション向けに最大6台のパリティドライブ\nチェックサムがサイレントな破損を検出し、残ったドライブのファイルは引き続き読み取れる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기가 다른 드라이브를 자유롭게 섞어도 공간 손실 없음\n대규모 컬렉션을 위해 최대 6개의 패리티 드라이브 지원\n체크섬으로 눈에 띄지 않는 손상을 감지하며, 남은 드라이브의 파일은 계속 읽을 수 있음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina livremente unidades de tamanhos diferentes, sem perder espaço\nAté seis unidades de paridade para coleções grandes\nSomas de verificação detectam corrupção silenciosa, e os arquivos das unidades que sobrevivem continuam legíveis"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随意混用不同容量的硬盘，不损失空间\n大型收藏可使用最多六块校验盘\n校验和可检测静默损坏，未故障硬盘上的文件仍可读取"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可自由混用不同容量的硬碟，不損失任何空間\n大量資料最多可使用六顆同位元硬碟\n總和檢查碼可偵測無聲損毀，倖存硬碟上的檔案仍可讀取"
          }
        }
      }
    },
    "snapraid_use_cases" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediatheken, die sich selten ändern\nArchive auf alten und neuen Laufwerken\nHeimserver zusammen mit einem Pooling-Tool"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media libraries that rarely change\nArchives on mixed old and new drives\nHome servers alongside a drive-pooling tool"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotecas multimedia que cambian poco\nArchivos en unidades antiguas y nuevas\nServidores domésticos junto con una herramienta de agrupación de unidades"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Médiathèques qui changent rarement\nArchives sur des disques anciens et récents\nServeurs domestiques associés à un outil de regroupement de disques"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Librerie multimediali che cambiano raramente\nArchivi su dischi vecchi e nuovi\nServer domestici insieme a uno strumento di pooling dei dischi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんど変更されないメディアライブラリ\n新旧のドライブが混在するアーカイブ\nドライブプーリングツールと組み合わせた家庭用サーバー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거의 변경되지 않는 미디어 라이브러리\n새 드라이브와 오래된 드라이브가 섞인 아카이브\n드라이브 풀링 도구와 함께 사용하는 홈 서버"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibliotecas de mídia que raramente mudam\nArquivos em unidades antigas e novas misturadas\nServidores domésticos com uma ferramenta de agrupamento de unidades"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很少变动的媒体库\n新旧硬盘混用的归档\n搭配硬盘池工具使用的家用服务器"
