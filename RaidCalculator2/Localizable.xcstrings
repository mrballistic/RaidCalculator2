          }
        }
      }
    },
    "raidz2_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID-Z2 ist das ZFS-Layout mit doppelter Parität, ähnlich wie RAID 6. Zwei beliebige Laufwerke einer Gruppe dürfen ausfallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID-Z2 is ZFS’s dual-parity layout, similar to RAID 6. Any two drives in a group can fail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID-Z2 es la configuración de doble paridad de ZFS, similar a RAID 6. Pueden fallar dos unidades cualesquiera de un grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le RAID-Z2 est la disposition à double parité de ZFS, semblable au RAID 6. Deux disques quelconques d’un groupe peuvent tomber en panne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID-Z2 è la configurazione a doppia parità di ZFS, simile a RAID 6. Possono guastarsi due dischi qualsiasi di un gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID-Z2はZFSのデュアルパリティ構成で、RAID 6に似ています。グループ内のどの2台が故障しても耐えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID-Z2는 RAID 6과 비슷한 ZFS의 이중 패리티 구성입니다. 그룹 내 어떤 드라이브 2개에 장애가 발생해도 견딜 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RAID-Z2 é o layout de paridade dupla do ZFS, semelhante ao RAID 6. Quaisquer duas unidades de um grupo podem falhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID-Z2 是 ZFS 的双校验布局，类似于 RAID 6。组内任意两块硬盘故障都不会丢失数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID-Z2 是 ZFS 的雙重同位元配置，類似 RAID 6。群組中任意兩顆硬碟故障都能承受。"
          }
        }
      }
    },
    "raidz2_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersteht zwei beliebige Ausfälle pro Gruppe\nPrüfsummen erkennen und reparieren unbemerkte Datenfehler\nDie übliche Wahl für große Pools zu Hause"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survives any two failures per group\nChecksums detect and repair silent corruption\nThe common choice for large home pools"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrevive a dos fallos cualesquiera por grupo\nLas sumas de verificación detectan y reparan la corrupción silenciosa\nLa opción habitual para pools domésticos grandes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survit à deux pannes quelconques par groupe\nLes sommes de contrôle détectent et réparent la corruption silencieuse\nLe choix courant pour les grands pools domestiques"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sopravvive a due guasti qualsiasi per gruppo\nI checksum rilevano e riparano la corruzione silenziosa\nLa scelta più comune per i grandi pool domestici"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループごとにどの2台の故障にも耐えられる\nチェックサムがサイレントな破損を検出して修復\n大規模なホームプールの定番"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹마다 어떤 드라이브 2개에 장애가 발생해도 견딤\n체크섬으로 눈에 띄지 않는 손상을 감지하고 복구\n대규모 홈 풀에서 흔히 선택하는 레벨"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrevive a quaisquer duas falhas por grupo\nSomas de verificação detectam e reparam corrupção silenciosa\nA escolha mais comum para pools domésticos grandes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每组可承受任意两块硬盘故障\n校验和可检测并修复静默损坏\n大型家用存储池的常见选择"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個群組可承受任意兩顆故障\n總和檢查碼可偵測並修復無聲損毀\n大型家用儲存池的常見選擇"
          }
        }
      }
    },
