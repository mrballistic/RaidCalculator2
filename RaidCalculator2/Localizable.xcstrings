        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editing video e file di lavoro temporanei\nGiochi e applicazioni che richiedono I/O veloce\nSistemi cache o archiviazione temporanea"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ編集と一時作業ファイル\n高速I/Oを必要とするゲームとアプリケーション\nキャッシュまたは一時ストレージシステム"
