    "rebuild_caution" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebuilding RAID 5 on drives this large can take days, and a second failure during the rebuild loses the array. Consider RAID 6."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruir un RAID 5 con discos tan grandes puede tardar días, y un segundo fallo durante la reconstrucción hace perder el conjunto. Considera RAID 6."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconstruire un RAID 5 avec des disques aussi gros peut prendre des jours, et une seconde panne pendant la reconstruction fait perdre la grappe. Envisagez le RAID 6."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricostruire un RAID 5 con dischi così grandi può richiedere giorni e un secondo guasto durante la ricostruzione fa perdere l’array. Valuta il RAID 6."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これほど大容量のドライブではRAID 5の再構築に数日かかることがあり、その間に2台目が故障するとアレイ全体を失います。RAID 6を検討してください。"
          }
        }
      }
    },
