    "jbod_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple and flexible\nFull utilization of all drive capacity\nNo performance overhead from RAID calculations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple y flexible\nUtilización completa de toda la capacidad de unidades\nSin sobrecarga de rendimiento de cálculos RAID"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simple et flexible\nUtilisation complète de toute la capacité des disques\nAucune surcharge de performance des calculs RAID"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semplice e flessibile\nUtilizzazione completa di tutta la capacità dei dischi\nNessun overhead prestazioni dai calcoli RAID"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンプルで柔軟\nすべてのドライブ容量の完全な利用\nRAID計算からのパフォーマンスオーバーヘッドなし"
          }
        }
      }
    },
