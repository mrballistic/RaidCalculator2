    "raid1_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50% storage capacity efficiency\nHigher cost per usable GB\nWrite performance similar to single drive"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiencia de capacidad de almacenamiento del 50%\nCosto más alto por GB utilizable\nRendimiento de escritura similar a unidad única"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficacité de capacité de stockage de 50%\nCoût plus élevé par GB utilisable\nPerformances en écriture similaires à un seul disque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficienza capacità di archiviazione del 50%\nCosto più alto per GB utilizzabile\nPrestazioni in scrittura simili a un singolo disco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージ容量効率50%\n使用可能GBあたりのコストが高い\n単一ドライブに類似した書き込みパフォーマンス"
          }
        }
      }
    },
    "raid1_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Mirroring) creates exact copies of data on multiple drives. Provides excellent redundancy but halves the usable capacity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Mirroring) crea copias exactas de datos en múltiples unidades. Proporciona excelente redundancia pero reduce a la mitad la capacidad utilizable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Mirroring) crée des copies exactes des données sur plusieurs disques. Fournit une excellente redondance mais réduit de moitié la capacité utilisable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1 (Mirroring) crea copie esatte dei dati su più dischi. Fornisce eccellente ridondanza ma dimezza la capacità utilizzabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 1（ミラーリング）は複数のドライブにデータの正確なコピーを作成します。優れた冗長性を提供しますが、使用可能容量は半分になります。"
          }
        }
      }
    },
