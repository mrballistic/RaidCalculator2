    "raid10_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 % Speichereffizienz\nBraucht eine gerade Anzahl Laufwerke (mindestens 4)\nHöhere Kosten pro nutzbarem GB"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50% storage capacity efficiency\nRequires even number of drives (minimum 4)\nHigher cost per usable GB"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiencia de capacidad de almacenamiento del 50%\nRequiere número par de unidades (mínimo 4)\nCosto más alto por GB utilizable"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficacité de capacité de stockage de 50%\nNécessite un nombre pair de disques (minimum 4)\nCoût plus élevé par GB utilisable"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficienza capacità di archiviazione del 50%\nRichiede numero pari di dischi (minimo 4)\nCosto più alto per GB utilizzabile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージ容量効率50%\n偶数のドライブが必要（最小4）\n使用可能GBあたりのコストが高い"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스토리지 용량 효율 50%\n짝수 개의 드라이브 필요(최소 4개)\n사용 가능 GB당 비용이 높음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50% de eficiência da capacidade de armazenamento\nRequer um número par de unidades (mínimo de 4)\nCusto mais alto por GB utilizável"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储容量利用率为 50%\n需要偶数块硬盘（至少 4 块）\n每 GB 可用容量的成本较高"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存容量效率為 50%\n需要偶數顆硬碟（至少 4 顆）\n每 GB 可用容量的成本較高"
          }
        }
      }
    },
    "raid10_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe aus Spiegeln) kombiniert Spiegelung und Striping. Bietet sehr gute Leistung und Redundanz, braucht aber eine gerade Anzahl Laufwerke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe of Mirrors) combines mirroring and striping. Provides excellent performance and redundancy but requires even number of drives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe de Mirrors) combina mirroring y striping. Proporciona excelente rendimiento y redundancia pero requiere un número par de unidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe de Mirrors) combine mirroring et striping. Fournit d’excellentes performances et redondance mais nécessite un nombre pair de disques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe di Mirror) combina mirroring e striping. Fornisce eccellenti prestazioni e ridondanza ma richiede un numero pari di dischi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10（ストライプオブミラー）はミラーリングとストライピングを組み合わせます。優れたパフォーマンスと冗長性を提供しますが、偶数のドライブが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10(미러의 스트라이프)은 미러링과 스트라이핑을 결합합니다. 뛰어난 성능과 중복성을 제공하지만 짝수 개의 드라이브가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RAID 10 (stripe de espelhos) combina espelhamento e striping. Oferece excelente desempenho e redundância, mas requer um número par de unidades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10（镜像的条带）结合了镜像和条带化。性能和冗余都很出色，但需要偶数块硬盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10（鏡像的等量分割）結合了鏡像與等量分割，提供優異的效能與備援，但需要偶數顆硬碟。"
          }
        }
      }
    },
    "raid10_failures" : {
      "extractionState" : "manual",
      "localizations" : {
