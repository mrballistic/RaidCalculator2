    "btrfs_calculation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usable space is half the total, unless one drive is larger than all the others combined; then it’s the total of the smaller drives, and the rest of the largest drive is shown as unused. Each drive is drawn half data, half copy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio utilizable es la mitad del total, salvo que una unidad sea más grande que todas las demás juntas; en ese caso es la suma de las unidades más pequeñas, y el resto de la unidad más grande se muestra sin usar. Cada unidad se dibuja mitad datos, mitad copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace utilisable correspond à la moitié du total, sauf si un disque est plus grand que tous les autres réunis ; il correspond alors au total des plus petits disques, et le reste du plus grand disque est indiqué comme inutilisé. Chaque disque est représenté à moitié données, à moitié copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio utilizzabile è metà del totale, a meno che un disco non sia più grande di tutti gli altri messi insieme; in quel caso è il totale dei dischi più piccoli, e il resto del disco più grande è indicato come inutilizzato. Ogni disco è disegnato per metà dati e per metà copia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用可能容量は総容量の半分です。ただし、1つのドライブが他のすべてのドライブの合計より大きい場合は、小さいドライブの合計となり、最大のドライブの残りは未使用として表示されます。各ドライブは半分をデータ、半分をコピーとして描いています。"
          }
        }
      }
    },
    "btrfs_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half the total space holds the second copy\nSurvives only one drive failure, however many drives there are\nOne drive larger than all the others combined can’t be fully mirrored"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mitad del espacio total guarda la segunda copia\nSolo sobrevive a un fallo de unidad, sin importar cuántas unidades haya\nUna unidad más grande que todas las demás juntas no se puede duplicar por completo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moitié de l’espace total contient la seconde copie\nNe survit qu’à une seule panne de disque, quel que soit le nombre de disques\nUn disque plus grand que tous les autres réunis ne peut pas être entièrement mis en miroir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metà dello spazio totale contiene la seconda copia\nSopravvive a un solo guasto del disco, qualunque sia il numero di dischi\nUn disco più grande di tutti gli altri messi insieme non può essere interamente in mirror"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "総容量の半分が2つ目のコピーに使われる\nドライブ数に関係なく、1つのドライブ故障にしか耐えられない\n他のすべてのドライブの合計より大きいドライブは、全体をミラーできない"
          }
        }
      }
    },
    "btrfs_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 keeps two copies of every block of data, on two different drives. Drives can be different sizes; Btrfs places the copies so they balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 guarda dos copias de cada bloque de datos, en dos unidades distintas. Las unidades pueden ser de distintos tamaños; Btrfs coloca las copias de forma equilibrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Btrfs RAID1 conserve deux copies de chaque bloc de données, sur deux disques différents. Les disques peuvent être de tailles différentes ; Btrfs place les copies de façon équilibrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 conserva due copie di ogni blocco di dati, su due dischi diversi. I dischi possono avere dimensioni diverse; Btrfs distribuisce le copie in modo bilanciato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1は、すべてのデータブロックのコピーを2つ、別々のドライブに保持します。ドライブの容量は異なっていてもよく、Btrfsは偏りが出ないようにコピーを配置します。"
          }
        }
      }
    },
    "btrfs_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix drive sizes with little wasted space\nAdd or remove drives and rebalance while the volume stays online\nChecksums detect corruption and repair it from the other copy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite combinar unidades de distintos tamaños con poco espacio desperdiciado\nPermite añadir o quitar unidades y reequilibrar sin desconectar el volumen\nLas sumas de verificación detectan la corrupción y la reparan con la otra copia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disques de tailles différentes combinables avec peu d’espace perdu\nAjout ou retrait de disques et rééquilibrage pendant que le volume reste en ligne\nLes sommes de contrôle détectent la corruption et la réparent à partir de l’autre copie"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dischi di dimensioni diverse combinabili con poco spazio sprecato\nSi possono aggiungere o rimuovere dischi e ribilanciare mentre il volume resta online\nI checksum rilevano la corruzione e la riparano dall’altra copia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量の異なるドライブを組み合わせても無駄が少ない\nボリュームをオンラインのままドライブの追加・削除やリバランスが可能\nチェックサムが破損を検出し、もう一方のコピーから修復"
          }
        }
      }
    },
    "btrfs_raid1_validation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 needs at least 2 drives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 necesita al menos 2 discos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Btrfs RAID1 nécessite au moins 2 disques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1 richiede almeno 2 dischi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Btrfs RAID1には2台以上のドライブが必要です。"
          }
        }
      }
    },
    "btrfs_use_cases" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small home servers with a few mixed drives\nLinux servers and NAS systems built on Btrfs\nSetups that grow a drive at a time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequeños servidores domésticos con pocas unidades de distintos tamaños\nServidores Linux y sistemas NAS basados en Btrfs\nConfiguraciones que crecen unidad a unidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petits serveurs domestiques avec quelques disques de tailles différentes\nServeurs Linux et NAS reposant sur Btrfs\nConfigurations qui s’agrandissent disque par disque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piccoli server domestici con pochi dischi di dimensioni diverse\nServer Linux e sistemi NAS basati su Btrfs\nConfigurazioni che crescono un disco alla volta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量の異なる少数のドライブを搭載した小規模ホームサーバー\nBtrfsベースのLinuxサーバーやNASシステム\nドライブを1つずつ増やしていく構成"
          }
        }
      }
    },
