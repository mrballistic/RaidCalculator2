    "raid10_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr gute Lese- und Schreibleistung\nHohe Redundanz mit schnellem Rebuild\nÜbersteht mehrere Laufwerksausfälle (wenn sie in verschiedenen Spiegeln liegen)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excellent performance for reads and writes\nHigh redundancy with fast rebuild\nCan survive multiple drive failures (if in different mirrors)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excelente rendimiento para lecturas y escrituras\nAlta redundancia con reconstrucción rápida\nPuede sobrevivir a múltiples fallos de unidad (si en diferentes mirrors)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excellentes performances pour lectures et écritures\nHaute redondance avec reconstruction rapide\nPeut survivre à plusieurs pannes de disque (si dans différents mirrors)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eccellenti prestazioni in lettura e scrittura\nAlta ridondanza con ricostruzione rapida\nPuò sopravvivere a più guasti dei dischi (se in mirror diversi)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取りと書き込みの優れたパフォーマンス\n高速な再構築での高い冗長性\n複数のドライブ故障に耐えられる（異なるミラーの場合）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뛰어난 읽기 및 쓰기 성능\n빠른 재구축과 높은 중복성\n여러 드라이브 장애를 견딜 수 있음(서로 다른 미러에 있는 경우)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excelente desempenho de leitura e gravação\nAlta redundância com reconstrução rápida\nPode sobreviver a várias falhas de unidade (se estiverem em espelhos diferentes)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读写性能出色\n冗余度高，重建快\n可承受多块硬盘故障（如果位于不同的镜像中）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀寫效能優異\n備援程度高，重建速度快\n可承受多顆硬碟故障（若分屬不同鏡像）"
          }
        }
      }
    },
