        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 ZFS 설정 기준 추정치입니다. 압축, 레코드 크기, 섹터 크기에 따라 실제 수치는 달라집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa para as configurações padrão do ZFS. A compressão, o tamanho de registro e o tamanho de setor alteram o número real."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ZFS 默认设置估算。压缩、记录大小和扇区大小会改变实际数值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此為 ZFS 預設設定下的估計值。壓縮、記錄大小與磁區大小都會改變實際數字。"
          }
        }
      }
    },
