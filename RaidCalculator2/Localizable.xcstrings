    "raid5_pros" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gute Balance aus Leistung und Redundanz\nEffiziente Nutzung der Speicherkapazität\nÜbersteht einen Laufwerksausfall"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good balance of performance and redundancy\nEfficient use of storage capacity\nCan survive one drive failure"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buen equilibrio de rendimiento y redundancia\nUso eficiente de capacidad de almacenamiento\nPuede sobrevivir a un fallo de unidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon équilibre de performance et redondance\nUtilisation efficace de la capacité de stockage\nPeut survivre à une panne de disque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buon equilibrio tra prestazioni e ridondanza\nUso efficiente della capacità di archiviazione\nPuò sopravvivere a un guasto del disco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パフォーマンスと冗長性の良いバランス\nストレージ容量の効率的な使用\n1つのドライブ故障に耐えられる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성능과 중복성의 균형이 좋음\n스토리지 용량을 효율적으로 사용\n드라이브 장애 1개를 견딜 수 있음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bom equilíbrio entre desempenho e redundância\nUso eficiente da capacidade de armazenamento\nPode sobreviver à falha de uma unidade"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
