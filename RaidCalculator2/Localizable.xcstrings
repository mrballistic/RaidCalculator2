    "zfs_use_cases" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueNAS, Proxmox and other ZFS servers\nPhoto, document and backup archives\nPools where data integrity matters most"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueNAS, Proxmox y otros servidores ZFS\nArchivos de fotos, documentos y backups\nPools en los que la integridad de los datos es lo más importante"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueNAS, Proxmox et autres serveurs ZFS\nArchives de photos, de documents et de sauvegardes\nPools où l’intégrité des données prime"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TrueNAS, Proxmox e altri server ZFS\nArchivi di foto, documenti e backup\nPool in cui l’integrità dei dati conta più di tutto"
          }
        },
        "ja" : {
          "stringUnit" : {
