    "raid0_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Redundanz und kein Datenschutz\nEin einziger Laufwerksausfall führt zum Verlust aller Daten\nNicht für wichtige Daten geeignet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No data redundancy or protection\nSingle drive failure causes complete data loss\nNot suitable for critical data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin redundancia o protección de datos\nUn solo fallo de unidad causa pérdida total de datos\nNo adecuado para datos críticos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune redondance ou protection de données\nUne seule panne de disque cause perte totale de données\nNon adapté aux données critiques"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna ridondanza o protezione dati\nUn singolo guasto del disco causa perdita totale dei dati\nNon adatto a dati critici"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ冗長性または保護なし\n単一ドライブ故障で完全なデータ損失\n重要なデータには不適切"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 중복성 또는 보호 없음\n드라이브 하나만 장애가 발생해도 모든 데이터 손실\n중요한 데이터에는 적합하지 않음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem redundância ou proteção de dados\nA falha de uma única unidade causa perda total dos dados\nNão é adequado para dados críticos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有数据冗余或保护\n一块硬盘故障即导致全部数据丢失\n不适合重要数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有資料備援或保護\n單一硬碟故障就會遺失所有資料\n不適合重要資料"
          }
        }
      }
    },
    "raid0_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) verteilt Daten für maximale Geschwindigkeit auf mehrere Laufwerke, bietet aber keine Redundanz. Fällt ein Laufwerk aus, sind alle Daten verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) splits data across multiple drives for maximum performance, but provides no redundancy. If any drive fails, all data is lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) divide los datos en múltiples unidades para máximo rendimiento, pero no proporciona redundancia. Si alguna unidad falla, todos los datos se pierden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) divise les données sur plusieurs disques pour des performances maximales, mais ne fournit aucune redondance. Si un disque tombe en panne, toutes les données sont perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) suddivide i dati su più dischi per prestazioni massime, ma non fornisce ridondanza. Se un disco si guasta, tutti i dati vengono persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0（ストライピング）は最大のパフォーマンスのために複数のドライブにデータを分割しますが、冗長性を提供しません。ドライブが1つでも故障すると、すべてのデータが失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0(스트라이핑)은 최대 성능을 위해 데이터를 여러 드라이브에 분산하지만 중복성은 제공하지 않습니다. 드라이브 하나라도 장애가 발생하면 모든 데이터가 손실됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RAID 0 (striping) divide os dados entre várias unidades para obter o máximo desempenho, mas não oferece redundância. Se alguma unidade falhar, todos os dados são perdidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0（条带化）将数据分散到多块硬盘上以获得最高性能，但不提供冗余。任何一块硬盘故障，所有数据都会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0（等量分割）將資料分散到多顆硬碟以發揮最大效能，但不提供任何備援。只要有一顆硬碟故障，所有資料都會遺失。"
          }
        }
      }
    },
