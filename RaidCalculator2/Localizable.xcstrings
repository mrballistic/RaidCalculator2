        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good balance of performance and redundancy\nEfficient use of storage capacity\nCan survive one drive failure"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buen equilibrio de rendimiento y redundancia\nUso eficiente de capacidad de almacenamiento\nPuede sobrevivir a un fallo de unidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon équilibre de performance et redondance\nUtilisation efficace de la capacité de stockage\nPeut survivre à une panne de disque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
