    "raid10_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe of Mirrors) combines mirroring and striping. Provides excellent performance and redundancy but requires even number of drives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe de Mirrors) combina mirroring y striping. Proporciona excelente rendimiento y redundancia pero requiere un número par de unidades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe de Mirrors) combine mirroring et striping. Fournit d'excellentes performances et redondance mais nécessite un nombre pair de disques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10 (Stripe di Mirror) combina mirroring e striping. Fornisce eccellenti prestazioni e ridondanza ma richiede un numero pari di dischi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 10（ストライプオブミラー）はミラーリングとストライピングを組み合わせます。優れたパフォーマンスと冗長性を提供しますが、偶数のドライブが必要です。"
          }
        }
      }
    },
