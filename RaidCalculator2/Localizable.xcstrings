    "shr_footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHR builds RAID in layers of matching capacity, so mixed drive sizes waste less space than classic RAID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHR crea el RAID en capas de igual capacidad, así que los discos de distintos tamaños desperdician menos espacio que con RAID clásico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le SHR construit le RAID par couches de capacité identique : des disques de tailles différentes gaspillent ainsi moins d’espace qu’en RAID classique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHR crea il RAID a strati di pari capacità, quindi dischi di dimensioni diverse sprecano meno spazio rispetto al RAID classico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SHRは同じ容量の層ごとにRAIDを構成するため、容量の異なるドライブでも従来のRAIDより無駄が少なくなります。"
          }
        }
      }
    },
    "speed" : {
