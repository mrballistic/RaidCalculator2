    "raid0_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No data redundancy or protection\nSingle drive failure causes complete data loss\nNot suitable for critical data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin redundancia o protección de datos\nUn solo fallo de unidad causa pérdida total de datos\nNo adecuado para datos críticos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune redondance ou protection de données\nUne seule panne de disque cause perte totale de données\nNon adapté aux données critiques"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna ridondanza o protezione dati\nUn singolo guasto del disco causa perdita totale dei dati\nNon adatto a dati critici"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ冗長性または保護なし\n単一ドライブ故障で完全なデータ損失\n重要なデータには不適切"
          }
        }
      }
    },
    "raid0_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) splits data across multiple drives for maximum performance, but provides no redundancy. If any drive fails, all data is lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) divide los datos en múltiples unidades para máximo rendimiento, pero no proporciona redundancia. Si alguna unidad falla, todos los datos se pierden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) divise les données sur plusieurs disques pour des performances maximales, mais ne fournit aucune redondance. Si un disque tombe en panne, toutes les données sont perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0 (Striping) suddivide i dati su più dischi per prestazioni massime, ma non fornisce ridondanza. Se un disco si guasta, tutti i dati vengono persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAID 0（ストライピング）は最大のパフォーマンスのために複数のドライブにデータを分割しますが、冗長性を提供しません。ドライブが1つでも故障すると、すべてのデータが失われます。"
          }
        }
      }
    },
