    "jbod_cons" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Redundanz und kein Datenschutz\nEin Laufwerksausfall betrifft nur die Daten auf diesem Laufwerk\nKein Geschwindigkeitsvorteil durch Striping"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No redundancy or data protection\nDrive failure affects only data on that drive\nNo performance benefits of striping"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin redundancia o protección de datos\nEl fallo de unidad afecta solo datos en esa unidad\nSin beneficios de rendimiento de striping"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune redondance ou protection de données\nLa panne de disque n’affecte que les données sur ce disque\nAucun bénéfice de performance du striping"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna ridondanza o protezione dati\nIl guasto del disco influisce solo sui dati su quel disco\nNessun beneficio prestazioni dello striping"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ冗長性または保護なし\nドライブ故障はそのドライブのデータのみに影響\nストライピングのパフォーマンス利点なし"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중복성 또는 데이터 보호 없음\n드라이브 장애 시 해당 드라이브의 데이터만 영향받음\n스트라이핑의 성능 이점 없음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem redundância ou proteção de dados\nA falha de uma unidade afeta apenas os dados dessa unidade\nSem os ganhos de desempenho do striping"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有冗余或数据保护\n硬盘故障只影响该硬盘上的数据\n没有条带化带来的性能优势"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有備援或資料保護\n硬碟故障只會影響該硬碟上的資料\n沒有等量分割帶來的效能優勢"
          }
        }
      }
    },
    "jbod_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) fasst mehrere Laufwerke ohne RAID-Funktionen zu einem großen Volume zusammen. Jedes Laufwerk arbeitet unabhängig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) combines multiple drives as one large volume without any RAID features. Each drive operates independently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) combina múltiples unidades como un solo volumen grande sin características RAID. Cada unidad opera independientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) combine plusieurs disques comme un seul grand volume sans fonctionnalités RAID. Chaque disque opère indépendamment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD (Just a Bunch Of Disks) combina più dischi come un unico volume grande senza funzionalità RAID. Ogni disco opera indipendentemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD（ジャストアバンチオブディスクス）はRAID機能なしで複数のドライブを1つの大きなボリュームとして結合します。各ドライブは独立して動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD(Just a Bunch Of Disks)는 RAID 기능 없이 여러 드라이브를 하나의 큰 볼륨으로 결합합니다. 각 드라이브는 독립적으로 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O JBOD (Just a Bunch Of Disks) combina várias unidades em um único volume grande, sem recursos de RAID. Cada unidade funciona de forma independente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD（Just a Bunch Of Disks，简单磁盘捆绑）将多块硬盘合并为一个大卷，不使用任何 RAID 功能。每块硬盘独立运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JBOD（Just a Bunch Of Disks）將多顆硬碟合併為一個大型磁碟區，不使用任何 RAID 功能。每顆硬碟各自獨立運作。"
          }
        }
      }
    },
